<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginBottom="50dp"
    android:background="#ffffff">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:title="My Meeting Schedule"
        android:id="@+id/bar"
        app:titleTextColor="#ffffff"
        android:background="@color/purple_700"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:id="@+id/empty"
        android:padding="24dp">

        <!-- ILLUSTRATION -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/cal"
            android:contentDescription="Empty Schedule" />

        <!-- TITLE -->
        <TextView
            android:layout_marginTop="24dp"
            android:text="No schedules yet"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_marginTop="8dp"
            android:text="Add a new schedule to get started."
            android:textSize="14sp"
            android:textColor="#8E8E93"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:layout_below="@+id/bar"
        android:layout_weight="1" />

    <!-- ADD BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddAlarm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/add_scheduler"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/purple_700"
        android:layout_alignParentBottom="true"
        app:icon="@android:drawable/ic_lock_idle_alarm"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="28dp" />
