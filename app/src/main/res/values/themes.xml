<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Theme.dnd" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/purple_700</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Existing global white status bar -->
        <item name="colorPrimaryDark">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>

    </style>

    <!-- Used only by HelpFaqActivity -->
    <style name="HelpFaqTheme" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/purple_700</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

    </style>

    <style name="OtpBox">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:background">@drawable/edit_bg</item>
        <item name="android:layout_margin">4dp</item>
    </style>

</resources>