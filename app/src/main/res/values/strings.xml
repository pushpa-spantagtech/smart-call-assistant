    <string name="help_faq_title">Help &amp; FAQ</string>
    <string name="help_intro_title">How to use the application</string>
    <string name="help_intro_text">Follow these steps to create your account, sign in, allow the required permissions and create schedules.</string>
    <string name="faq_login_title">How do I log in?</string>
    <string name="faq_login_answer">Open the Login page, enter your registered 10-digit mobile number and password, then tap Login.</string>
    <string name="faq_signup_title">How do I create an account?</string>
    <string name="faq_signup_answer">On the Login page, tap Sign Up. Enter your full name, mobile number, email address, password and confirm password, then tap Register.</string>
    <string name="faq_forgot_title">What should I do if I forget my password?</string>
    <string name="faq_forgot_answer">Tap Forgot Password on the Login page. Enter your registered email address, verify the OTP, create a new password and confirm it.</string>
    <string name="faq_permissions_title">Why does the app request permissions?</string>
    <string name="faq_permissions_answer">The application needs notification, Do Not Disturb, exact alarm and battery-related permissions so schedules can run correctly. Allow the requested permissions when prompted.</string>
    <string name="faq_schedule_title">How do I create a schedule?</string>
    <string name="faq_schedule_answer">Open the Schedule tab, choose the required date and time, configure the schedule options and save it. Review saved schedules in the schedule list.</string>
    <string name="faq_notifications_title">Why did my schedule not run?</string>
    <string name="faq_notifications_answer">Check that all required permissions are enabled, battery optimization is disabled for this app and the schedule date and time are correct.</string>
    <string name="faq_logout_title">How do I log out?</string>
    <string name="faq_logout_answer">Open the Support tab, tap Logout and confirm. You will return to the Login page.</string>
